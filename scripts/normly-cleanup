#!/usr/bin/env bash
# SPDX-License-Identifier: AGPL-3.0-or-later
# Copyright (C) 2026 normly contributors
#
# Daily enforcement of the retention periods for user data (user-data
# lifecycle): runs the pipeline's cleanup-user-data command in the current
# release. Started by normly-cleanup.timer; the exit code is the command's.
#
#   normly-cleanup
set -euo pipefail

NORMLY_DIR="${NORMLY_DIR:-/opt/normly}"
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091  # sourced helper, linted on its own
. "$HERE/normly-env.sh"
if [ $# -gt 0 ]; then
  echo "usage: normly-cleanup" >&2
  exit 2
fi
normly_load_env "$NORMLY_DIR/.env"
COMPOSE="${NORMLY_COMPOSE:-docker compose -f $NORMLY_DIR/current/compose.yaml --project-directory $NORMLY_DIR/current}"

# shellcheck disable=SC2086 # COMPOSE is a command line and must word-split
exec $COMPOSE run --rm --no-deps -T pipeline cleanup-user-data
